# ---------------------------------------------------------------------------
# Astro Smart Attendance — mailer configuration
#
#   cp .env.example .env      then fill in the values
#
# .env is git-ignored. Never commit it, never paste the secret key anywhere the
# ESP32 or a browser can read it — the device only ever gets the publishable key.
# ---------------------------------------------------------------------------

# Your project URL (Project Settings > API > Project URL)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings > API > Project API keys > secret key (sb_secret_...).
# NOT the publishable/anon key: rows are readable by guardians, but sending is
# server-only.
SUPABASE_SECRET_KEY=

# --- who the mail appears to come from -------------------------------------
# Must be an address you are allowed to send from.
MAIL_FROM=notices@yourschool.in
MAIL_FROM_NAME=School Office
MAIL_REPLY_TO=office@yourschool.in
SCHOOL_NAME=Sunrise Public School

# --- provider: resend | smtp | console -------------------------------------
# resend  — recommended. Free 3,000 emails/month (100/day). Verify your domain
#           at resend.com/domains, create an API key, done.
# smtp    — any mail server, including Gmail with a 16-character app password.
# console — prints emails to the terminal and marks them sent. Testing only.
MAIL_PROVIDER=resend

RESEND_API_KEY=

# Only used when MAIL_PROVIDER=smtp.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourschool@gmail.com
SMTP_PASS=

# --- throughput / pacing ---------------------------------------------------
# How many queued emails to take per pass, and how long to sleep when the queue
# is empty. A class-wide notice to 60 families is 60 rows; they drain in batches.
BATCH_SIZE=20
INTERVAL_MS=30000
SEND_DELAY_MS=0
